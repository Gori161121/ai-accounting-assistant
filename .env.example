# Database (for the persistence roadmap item — schema in database/schema.sql)
DATABASE_URL=postgresql://user:password@localhost:5432/accounting

ENVIRONMENT=development

# Optional — enables AI-generated executive summaries.
# Without it, the report uses a deterministic rule-based summary.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Tax assumptions used by the estimation engine
VAT_RATE=0.18
INCOME_TAX_RATE=0.20
